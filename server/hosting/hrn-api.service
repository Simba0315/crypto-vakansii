# Jobs Every Hour: the API (accounts, job alerts, employer postings, company pages), server/prod.mjs on 127.0.0.1:8787.
# Installed by api-setup.sh, which puts the path of Node 22 in place of NODEBIN. It runs as its own user (hrnapi), reads its settings
# from /srv/hrn/api.env, writes only its database folder, and may take at most 512 MB of memory and half of one processor.
[Unit]
Description=Jobs Every Hour API
After=network.target hrn-site.service
Wants=hrn-site.service

[Service]
User=hrnapi
Group=hrnapi
WorkingDirectory=/srv/hrn/api
Environment=API_ENV=/srv/hrn/api.env
ExecStart=NODEBIN --no-warnings /srv/hrn/api/server/prod.mjs
Restart=always
RestartSec=2
TimeoutStopSec=30
MemoryMax=512M
CPUQuota=50%
Nice=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hrn/api/data
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
